# Copy to .env and fill in. Generate secrets with: backend/manage.py generate_secrets
MINERVA_DEBUG=true
MINERVA_SECRET_KEY=change-me
# "version:key" entries, comma separated. The first encrypts; all decrypt (for rotation).
MINERVA_ENCRYPTION_KEYS=v1:change-me

MINERVA_DATABASE_URL=postgres://minerva:minerva@localhost:5432/minerva
# PlanetScale: pooled URL on port 6432 for the app, direct URL on 5432 for LISTEN and migrations.
# MINERVA_DATABASE_URL=postgres://user:pass@host:6432/postgres?sslmode=verify-full
# MINERVA_DATABASE_TRANSACTION_POOLING=true
# MINERVA_DIRECT_DATABASE_URL=postgres://user:pass@host:5432/postgres?sslmode=verify-full

# Model access (any OpenAI-compatible endpoint).
MINERVA_MODEL_API_KEY=
MINERVA_MODEL_BASE_URL=https://api.openai.com/v1
MINERVA_MODEL_NAME=gpt-5-mini

# Todoist OAuth. Leave empty to let Minerva register its own OAuth client with Todoist.
MINERVA_TODOIST_CLIENT_ID=
MINERVA_TODOIST_CLIENT_SECRET=

# Google OAuth client (Web application) for Calendar and Drive. Empty: neither is offered.
MINERVA_GOOGLE_CLIENT_ID=
MINERVA_GOOGLE_CLIENT_SECRET=

# GitHub App (https://github.com/settings/apps); the slug is its URL name, for the install link.
# Empty: GitHub is not offered.
MINERVA_GITHUB_CLIENT_ID=
MINERVA_GITHUB_CLIENT_SECRET=
MINERVA_GITHUB_APP_SLUG=

# Notion public integration (https://www.notion.so/profile/integrations). Empty: Notion is not offered.
MINERVA_NOTION_CLIENT_ID=
MINERVA_NOTION_CLIENT_SECRET=

# Linear OAuth application (https://linear.app/settings/api/applications). Empty: Linear is not offered.
MINERVA_LINEAR_CLIENT_ID=
MINERVA_LINEAR_CLIENT_SECRET=

# Slack app (https://api.slack.com/apps), installed with bot scopes; its redirect URL must use HTTPS.
# Empty: Slack is not offered.
MINERVA_SLACK_CLIENT_ID=
MINERVA_SLACK_CLIENT_SECRET=

# Microsoft Entra app registration for Outlook, Outlook Calendar, OneDrive and SharePoint, and Microsoft
# Teams (https://entra.microsoft.com, App registrations), any organization and personal accounts. Empty:
# none of them is offered.
MINERVA_MICROSOFT_CLIENT_ID=
MINERVA_MICROSOFT_CLIENT_SECRET=

# HubSpot public app from a developer-platform project (https://developers.hubspot.com), with the scopes
# in README.md. Empty: HubSpot is not offered.
MINERVA_HUBSPOT_CLIENT_ID=
MINERVA_HUBSPOT_CLIENT_SECRET=

# Atlassian OAuth 2.0 (3LO) app for Jira (https://developer.atlassian.com/console/myapps/), with the scopes
# in README.md. Atlassian allows one callback URL per app, so Jira has its own. Empty: Jira is not offered.
MINERVA_JIRA_CLIENT_ID=
MINERVA_JIRA_CLIENT_SECRET=

# Atlassian OAuth 2.0 (3LO) app for Confluence, with the scopes in README.md. Atlassian allows one callback
# URL per app, so Confluence has its own. Empty: Confluence is not offered.
MINERVA_CONFLUENCE_CLIENT_ID=
MINERVA_CONFLUENCE_CLIENT_SECRET=

# Intercom app with OAuth (https://app.intercom.com/a/apps/_/developer-hub), with the permissions in
# README.md. Empty: Intercom is not offered.
MINERVA_INTERCOM_CLIENT_ID=
MINERVA_INTERCOM_CLIENT_SECRET=

# Xero web app (https://developer.xero.com/app/manage), with the scopes in README.md. Empty: Xero is not
# offered.
MINERVA_XERO_CLIENT_ID=
MINERVA_XERO_CLIENT_SECRET=

# Sentry OAuth application (https://sentry.io/settings/account/api/applications/), see README.md. Empty:
# Sentry is not offered.
MINERVA_SENTRY_CLIENT_ID=
MINERVA_SENTRY_CLIENT_SECRET=

# Brave Search API key for the Web connector (https://brave.com/search/api/). Empty: agents can read pages but not search.
MINERVA_BRAVE_SEARCH_API_KEY=

# Sandbox: "container" (Docker/Podman) or "local-process" (development only, no isolation).
MINERVA_SANDBOX_PROVIDER=container
MINERVA_SANDBOX_IMAGE=minerva-worker:dev
