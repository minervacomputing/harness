# Copy to .env and fill in. Generate secrets with: backend/manage.py generate_secrets
MINERVA_DEBUG=true
MINERVA_SECRET_KEY=change-me
# "version:key" entries, comma separated. The first encrypts; all decrypt (for rotation).
MINERVA_ENCRYPTION_KEYS=v1:change-me

MINERVA_DATABASE_URL=postgres://minerva:minerva@localhost:5432/minerva
# PlanetScale: pooled URL on port 6432 for the app, direct URL on 5432 for LISTEN and migrations.
# MINERVA_DATABASE_URL=postgres://user:pass@host:6432/postgres?sslmode=verify-full
# MINERVA_DATABASE_TRANSACTION_POOLING=true
# MINERVA_DIRECT_DATABASE_URL=postgres://user:pass@host:5432/postgres?sslmode=verify-full

# Model access (any OpenAI-compatible endpoint).
MINERVA_MODEL_API_KEY=
MINERVA_MODEL_BASE_URL=https://api.openai.com/v1
MINERVA_MODEL_NAME=gpt-5-mini

# Todoist OAuth. Leave empty to let Minerva register its own OAuth client with Todoist.
MINERVA_TODOIST_CLIENT_ID=
MINERVA_TODOIST_CLIENT_SECRET=

# Notion public integration (https://www.notion.so/profile/integrations). Empty: Notion is not offered.
MINERVA_NOTION_CLIENT_ID=
MINERVA_NOTION_CLIENT_SECRET=

# Brave Search API key for the Web connector (https://brave.com/search/api/). Empty: agents can read pages but not search.
MINERVA_BRAVE_SEARCH_API_KEY=

# Sandbox: "container" (Docker/Podman) or "local-process" (development only, no isolation).
MINERVA_SANDBOX_PROVIDER=container
MINERVA_SANDBOX_IMAGE=minerva-worker:dev
