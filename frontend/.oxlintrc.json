{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc", "typescript", "react", "jsx-a11y", "promise", "import", "unicorn", "vitest"],
  "jsPlugins": ["./lint/plugin.js"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "ignorePatterns": ["dist/", "src/routeTree.gen.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/immutability": "error",
    "import/no-cycle": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "@/lib/theme"] }],
    "jsx-a11y/label-has-associated-control": ["error", { "controlComponents": ["Checkbox", "Switch", "RadioItem"] }],

    // The chosen subset of unicorn, beyond its correctness and suspicious rules.
    "unicorn/error-message": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-lonely-if": "error",
    "unicorn/no-typeof-undefined": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-index-of": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/throw-new-error": "error",

    "vitest/no-identical-title": "error",
    "vitest/no-import-node-test": "error",

    // What keeps unwanted code out (AGENTS.md, Frontend).
    "minerva/no-component-tests": "error",
    "vitest/no-restricted-vi-methods": ["error", { "mock": "No module mocks.", "doMock": "No module mocks.", "hoisted": "No module mocks." }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "jsdom", "message": "Unit tests run without a DOM." },
          { "name": "happy-dom", "message": "Unit tests run without a DOM." }
        ],
        "patterns": [{ "group": ["@testing-library/*"], "message": "No component tests." }]
      }
    ],
    "no-restricted-globals": [
      "error",
      { "name": "localStorage", "message": "Browser storage stays in src/lib/." },
      { "name": "sessionStorage", "message": "Browser storage stays in src/lib/." }
    ],
    "no-restricted-properties": [
      "error",
      { "object": "window", "property": "localStorage", "message": "Browser storage stays in src/lib/." },
      { "object": "window", "property": "sessionStorage", "message": "Browser storage stays in src/lib/." },
      { "object": "globalThis", "property": "localStorage", "message": "Browser storage stays in src/lib/." },
      { "object": "globalThis", "property": "sessionStorage", "message": "Browser storage stays in src/lib/." }
    ],

    // Off: the automatic JSX runtime needs no React in scope.
    "react/react-in-jsx-scope": "off",
    // Off: a duplicate of react/exhaustive-deps.
    "react/exhaustive-effect-dependencies": "off",
    // Off: autofocus is deliberate, on the one field of a step (a code, a dialog, the composer).
    "jsx-a11y/no-autofocus": "off",
    // Off: the roles are on styled elements and SVGs on purpose (a status line, a logo, a progress bar).
    "jsx-a11y/prefer-tag-over-role": "off",
    // Off: there is no Express here; it reports the API client's async interceptors.
    "oxc/no-async-endpoint-handlers": "off",
    // Off: a small helper reads best next to its one caller.
    "unicorn/consistent-function-scoping": "off",
    // Off: an XHR's handlers are set where the request is made.
    "unicorn/prefer-add-event-listener": "off",
    // Off: a then() whose value nobody reads need not return one.
    "promise/always-return": "off"
  },
  "overrides": [{ "files": ["src/lib/**"], "rules": { "no-restricted-globals": "off", "no-restricted-properties": "off" } }]
}
