{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "esnext.disposable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["@cloudflare/vitest-plugin/types"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"resolveJsonModule": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"skipLibCheck": true
	},
	"include": ["src", "test/unit", "test/docker", "test/platform", "test/account/scripts-worker/src", "test/account/scripts-worker/cloudflare.config.ts", "reset-worker/src", "reset-worker/cloudflare.config.ts", "cloudflare.config.ts", ".cloudflare/types"],
	"exclude": ["test/unit/sources.test.ts", "test/unit/schema-check.test.ts", "test/unit/deploy-checks.test.ts", "test/unit/instance-directory.test.ts"]
}
