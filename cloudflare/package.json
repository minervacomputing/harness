{
  "name": "minerva-cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "cf build --mode standalone",
    "types": "cf workers types",
    "typecheck": "pnpm types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check": "node scripts/check.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:platform": "vitest run --config vitest.platform.config.ts",
    "test:deployed": "node scripts/suite.ts deployed",
    "test:faults": "node scripts/suite.ts faults",
    "sandbox:image": "docker build -t minerva-sandbox:local container",
    "test:cm": "node scripts/suite.ts cm",
    "startup": "node scripts/startup.ts --build",
    "secrets": "node scripts/secrets.ts generate",
    "secrets:test": "node scripts/secrets.ts generate --test",
    "secrets:offline": "node scripts/secrets.ts generate --offline",
    "instances": "node scripts/instances.ts",
    "dev:offline": "node scripts/dev-offline.ts",
    "deploy": "node scripts/deploy.ts",
    "deploy:cm": "node scripts/deploy.ts --lab",
    "deploy:test": "node scripts/deploy.ts --test"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@minerva/contract": "workspace:*",
    "@orpc/client": "1.15.6",
    "@orpc/openapi": "1.15.6",
    "@orpc/openapi-client": "1.15.6",
    "@orpc/server": "1.15.6",
    "@zip.js/zip.js": "2.23.0",
    "acorn": "8.19.0",
    "agents": "0.28.0",
    "canonicalize": "5.1.0",
    "entities": "8.1.0",
    "hono": "4.13.9",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "pako": "2.1.0",
    "postal-mime": "4.0.5",
    "saxes": "6.0.0",
    "tldts": "7.4.18",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@orpc/contract": "1.15.6",
    "@types/node": "24.19.0",
    "@typescript/typescript6": "6.0.2",
    "cf": "1.0.0-beta.13",
    "fflate": "0.8.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
