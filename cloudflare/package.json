{
  "name": "minerva-cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "assets": "pnpm --dir ../frontend build && node scripts/assets.ts",
    "build": "pnpm assets && cf build && cd files-worker && cf build",
    "types": "cf workers types && cd files-worker && cf workers types",
    "typecheck": "pnpm types && tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p files-worker/tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:platform": "vitest run --config vitest.platform.config.ts",
    "test:account": "vitest run --config vitest.account.config.ts",
    "test:faults": "vitest run --config vitest.faults.config.ts",
    "sandbox:image": "docker build -t minerva-cf-sandbox:local container",
    "test:cm": "vitest run --config vitest.cm.config.ts",
    "seed": "node scripts/seed.ts",
    "startup": "node scripts/startup.ts --build",
    "auth:schema": "auth generate --config scripts/auth-schema.ts --output .cloudflare/auth-schema.sql --yes && cat .cloudflare/auth-schema.sql",
    "secrets": "node scripts/secrets.ts generate",
    "secrets:test": "node scripts/secrets.ts generate --test",
    "secrets:offline": "node scripts/secrets.ts generate --offline",
    "dev:offline": "node scripts/dev-offline.ts",
    "deploy": "pnpm assets && node scripts/deploy.ts",
    "deploy:files": "pnpm assets && node scripts/deploy.ts --files-only",
    "deploy:cm": "cd test/account/scripts-worker && cf deploy --secrets-file ../../../../.env.cloudflare-cm",
    "deploy:test": "pnpm assets && node scripts/deploy.ts --test"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@minerva/contract": "workspace:*",
    "@orpc/openapi": "1.15.6",
    "@orpc/server": "1.15.6",
    "@zip.js/zip.js": "2.23.0",
    "acorn": "8.19.0",
    "agents": "0.28.0",
    "better-auth": "1.7.7",
    "canonicalize": "5.1.0",
    "entities": "8.1.0",
    "hono": "4.13.9",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "oauth4webapi": "3.8.8",
    "pako": "2.1.0",
    "postal-mime": "4.0.5",
    "saxes": "6.0.0",
    "tldts": "7.4.18",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@orpc/client": "1.15.6",
    "@orpc/contract": "1.15.6",
    "@orpc/openapi-client": "1.15.6",
    "@types/node": "24.19.0",
    "auth": "1.7.7",
    "cf": "1.0.0-beta.13",
    "fflate": "0.8.2",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
