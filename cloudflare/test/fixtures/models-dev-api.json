								"body": {
									"service_tier": "priority"
								}
							}
						},
						"pro": {
							"provider": {
								"body": {
									"reasoning": {
										"mode": "pro"
									}
								}
							}
						},
						"ultrafast": {
							"cost": {
								"input": 12,
								"output": 60,
								"cache_read": 0.6,
								"cache_write": 15
							},
							"provider": {
								"body": {
									"service_tier": "ultrafast"
								}
							}
						}
					}
				},
				"cost": {
					"input": 2,
					"output": 10,
					"cache_read": 0.1,
					"cache_write": 2.5,
					"tiers": [
						{
							"input": 4,
							"output": 15,
							"cache_read": 0.2,
							"cache_write": 5,
							"tier": {
								"type": "context",
								"size": 272000
							}
						}
					],
					"context_over_200k": {
						"input": 4,
						"output": 15,
						"cache_read": 0.2,
						"cache_write": 5
					}
				},
				"canonical_model_id": "openai/gpt-6.1-sol"
			},
			"gpt-image-1": {
				"id": "gpt-image-1",
				"name": "gpt-image-1",
				"description": "OpenAI image model for production generation, edits, and brand-safe visual workflows",
				"family": "gpt-image",
				"attachment": true,
				"reasoning": false,
				"tool_call": false,
				"temperature": false,
				"release_date": "2025-04-24",
				"last_updated": "2025-04-24",
				"modalities": {
					"input": [
						"text",
						"image"
					],
					"output": [
						"image"
					]
				},
				"open_weights": false,
				"limit": {
					"context": 0,
					"input": 0,
					"output": 0
				},
				"status": "deprecated",
				"canonical_model_id": "openai/gpt-image-1"
			}
		}
	},
