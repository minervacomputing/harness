# The sandbox probe: checks from inside the sandbox that an agent command runs unprivileged, with a fixed
# environment, in the agent cgroup, with a writable and size-limited /workspace, a read-only root, a fork
# limit and no route out. Ports 80 and 443 accept and then reset, so those network checks go over HTTP and
# TLS rather than a bare TCP connect. The network checks run at once, one thread per target, so their
# timeouts overlap; a target counts as blocked only when it times out, is refused or is reset, and a listener
# of the probe's own is the positive control that an open route would be seen as open.
# It runs as an agent command does, through the wrapper as uid 1000 in the agent cgroup, with bash's fixed
# environment:
#
#     /usr/bin/python3 -I -S /opt/minerva/probe <folder bytes> <folder entries> <pids max> <cgroup> [<peer>...]
#
# where <cgroup> is the line /proc/self/cgroup must hold (`0::/agent` on the platform)
#
# and prints one JSON object: `checks` (every one must be true) and `details`. Started only by the account
# tests (test/account/sandbox.test.ts) and the Docker tests, never by a user run. The checks that need the Sandbox Durable Object
# (killing strays, a fork bomb, the hardening's postconditions) are made there.

import errno
import http.client
import json
import os
import socket
import ssl
import subprocess
import sys
import threading
import time

WORKSPACE = "/workspace"
MIB = 1024 * 1024
# What tmpfs charges beyond the data written: whole pages per file. The size check allows this much below.
SIZE_SLACK = 64 * 1024
# More processes than the sandbox may run, so a missing limit fails the check rather than passing it.
FORK_ATTEMPTS = 2048
# This probe and the wrapper's processes count towards the limit too.
FORK_BASELINE_MAX = 32
BASH_ENVIRONMENT = {"PATH", "HOME", "TMPDIR", "LANG", "MPLCONFIGDIR"}
SECRET_NAME = ("KEY", "SECRET", "PASSWORD", "CREDENTIAL", "DATABASE", "TOKEN")
TIMEOUT = 5

checks = {}
details = {}


def check(name, function):
    try:
        ok, detail = function()
    except Exception as error:  # A check that cannot run fails.
        ok, detail = False, f"{type(error).__name__}: {error}"
    checks[name] = bool(ok)
    details[name] = str(detail)[:500]


def status_fields():
    fields = {}
    with open("/proc/self/status") as file:
        for line in file:
            key, _, rest = line.partition(":")
            fields[key] = rest.strip()
    return fields


def non_root_user():
    fields = status_fields()
    caps = {key: fields.get(key) for key in ("CapInh", "CapPrm", "CapEff", "CapBnd", "CapAmb")}
    ok = (
        os.getuid() == 1000
        and os.geteuid() == 1000
        and os.getgid() == 1000
        and os.getgroups() in ([], [1000])
        and all(value == "0000000000000000" for value in caps.values())
        and fields.get("NoNewPrivs") == "1"
    )
    return ok, f"uid {os.getuid()} gid {os.getgid()} groups {os.getgroups()} {caps} NoNewPrivs {fields.get('NoNewPrivs')}"


def fixed_environment():
    names = set(os.environ)
    secrets = [name for name in names if any(part in name.upper() for part in SECRET_NAME)]
    return names == BASH_ENVIRONMENT and not secrets, sorted(names)


def pid1_environment_unreadable():
    try:
        with open("/proc/1/environ", "rb") as file:
            file.read()
    except PermissionError:
        return True, "EACCES"
    return False, "readable"


def in_agent_cgroup(expected):
    with open("/proc/self/cgroup") as file:
        text = file.read().strip()
    return text == expected, text


def run_script(directory):
    path = os.path.join(directory, f"probe-{os.getpid()}.sh")
    try:
        with open(path, "w") as file:
            file.write("#!/bin/sh\necho ran\n")
        os.chmod(path, 0o755)
    except OSError as error:
        return f"not written ({errno.errorcode.get(error.errno, error.errno)})"
    try:
        result = subprocess.run([path], capture_output=True, timeout=TIMEOUT)
        return "ran" if result.stdout == b"ran\n" else "wrong output"
    except PermissionError:
        return "EACCES"
    except OSError as error:
        return errno.errorcode.get(error.errno, str(error.errno))
    finally:
        try:
            os.remove(path)
        except OSError:
            pass


def workspace_writable():
    path = os.path.join(WORKSPACE, "probe.txt")
    with open(path, "w") as file:
        file.write("ok")
    os.remove(path)
    return True, "written"


def home_directories():
    out = []
    ok = True
    for name in ("HOME", "MPLCONFIGDIR"):
        path = os.environ.get(name, "")
        st = os.stat(path)
        writable = os.access(path, os.W_OK)
        ok = ok and os.path.isdir(path) and st.st_uid == 1000 and st.st_gid == 1000 and writable
        out.append(f"{name}={path} {st.st_uid}:{st.st_gid} {oct(st.st_mode & 0o7777)}")
    return ok and os.environ.get("TMPDIR") == "/tmp", "; ".join(out)


def empty_folder():
    for name in os.listdir(WORKSPACE):
        path = os.path.join(WORKSPACE, name)
        if os.path.isdir(path) and not os.path.islink(path):
            import shutil

            shutil.rmtree(path)
        else:
            os.remove(path)


def folder_size_limit(limit):
    empty_folder()
    chunk = b"\x01" * MIB
    written = 0
    code = None
    fd = os.open(os.path.join(WORKSPACE, "fill"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    try:
        # Never more than the limit plus a chunk, so a missing limit fails rather than fills memory.
        while written <= limit:
            try:
                count = os.write(fd, chunk)
            except OSError as error:
                code = errno.errorcode.get(error.errno)
                break
            written += count
            if count < len(chunk):
                try:
                    os.write(fd, chunk)
                except OSError as error:
                    code = errno.errorcode.get(error.errno)
                break
    finally:
        os.close(fd)
        empty_folder()
    return code == "ENOSPC" and limit - SIZE_SLACK <= written <= limit, f"{written} of {limit} bytes, then {code}"


def folder_entry_limit(limit):
    empty_folder()
    created = 0
    code = None
    try:
        while created <= limit:
            try:
                os.close(os.open(os.path.join(WORKSPACE, f"e{created}"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
            except OSError as error:
                code = errno.errorcode.get(error.errno)
                break
            created += 1
    finally:
        empty_folder()
    return code == "ENOSPC" and created == limit, f"{created} of {limit} entries, then {code}"


def root_read_only():
    # /home/agent belongs to the agent's user, so only a read-only root stops the write.
    results = {}
    for path in ("/home/agent/probe.txt", "/probe.txt", "/etc/probe.txt", "/var/tmp/probe.txt", "/opt/minerva/probe.txt"):
        try:
            with open(path, "w") as file:
                file.write("no")
            results[path] = "written"
        except OSError as error:
            results[path] = errno.errorcode.get(error.errno, str(error.errno))
    ok = results["/home/agent/probe.txt"] == "EROFS" and all(value in ("EROFS", "EACCES") for value in results.values())
    return ok, results


def writable_elsewhere():
    """Nothing the agent writes outside /workspace runs: every other mount it can write to (/tmp, and
    /dev/shm or /dev/mqueue where the platform has them) is mounted noexec, and none of them is kept."""
    found = []
    with open("/proc/self/mountinfo") as file:
        for line in file:
            fields = line.split()
            mount, options = fields[4], fields[5].split(",")
            if mount == WORKSPACE or mount.startswith(("/proc", "/sys")):
                continue
            if os.path.isdir(mount) and os.access(mount, os.W_OK):
                path = os.path.join(mount, f".probe-{os.getpid()}")
                try:
                    os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
                    os.remove(path)
                except OSError:
                    continue
                if "noexec" not in options:
                    found.append(mount)
    return not found, found or "none"


# What a blocked route answers: nothing in time, a refusal, or a reset. Any other failure (no file descriptors
# or threads left, an unexpected TLS error) is not evidence of a blocked route, so it fails the check.
BLOCKED_ERRORS = (
    TimeoutError,
    ConnectionRefusedError,
    ConnectionResetError,
    ConnectionAbortedError,
    BrokenPipeError,
    http.client.RemoteDisconnected,
    ssl.SSLEOFError,
    ssl.SSLZeroReturnError,
)
BLOCKED_ERRNOS = {errno.ENETUNREACH, errno.EHOSTUNREACH}
# getaddrinfo's answers when no resolver answers or the name does not resolve.
UNRESOLVED = {socket.EAI_AGAIN, socket.EAI_NONAME, socket.EAI_FAIL, getattr(socket, "EAI_NODATA", socket.EAI_NONAME)}
DNS_SECONDS = 30
# How long the network pass may take: the resolver's limit, and an HTTPS exchange is three socket timeouts.
NETWORK_SECONDS = DNS_SECONDS + 5


def failure(error):
    """("blocked", detail) for an outcome a blocked route gives, ("error", detail) for any other."""
    detail = f"{type(error).__name__}: {error}"
    if isinstance(error, BLOCKED_ERRORS) or (type(error) is OSError and error.errno in BLOCKED_ERRNOS):
        return "blocked", detail
    return "error", detail


def http_reach(host, port, tls):
    """("answered", status) when an HTTP answer comes back, else what failure() makes of the error."""
    if tls:
        context = ssl.create_default_context()
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        connection = http.client.HTTPSConnection(host, port, timeout=TIMEOUT, context=context)
    else:
        connection = http.client.HTTPConnection(host, port, timeout=TIMEOUT)
    try:
        connection.request("GET", "/", headers={"Host": "example.com"})
        return "answered", f"HTTP {connection.getresponse().status}"
    except Exception as error:
        return failure(error)
    finally:
        connection.close()


def tcp_reach(host, port):
    """("connected", ...) when a TCP connection is accepted, else what failure() makes of the error."""
    sock = socket.socket(socket.AF_INET6 if ":" in host else socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(3)
    try:
        sock.connect((host, port))
        return "connected", "connected"
    except Exception as error:
        return failure(error)
    finally:
        sock.close()


# Resolves in a child process, which a deadline can kill: getaddrinfo itself has no timeout.
RESOLVE = """
import socket
try:
    socket.getaddrinfo("example.com", 443)
    print("resolved")
except socket.gaierror as error:
    print(error.errno, error.strerror)
"""


def dns_reach():
    """("blocked", ...) when example.com does not resolve or no answer comes within DNS_SECONDS."""
    try:
        result = subprocess.run([sys.executable, "-I", "-S", "-c", RESOLVE], capture_output=True, text=True, timeout=DNS_SECONDS)
    except subprocess.TimeoutExpired:
        return "blocked", f"no answer within {DNS_SECONDS} s"
    answer = result.stdout.strip()
    if answer == "resolved":
        return "answered", "resolved"
    code, _, message = answer.partition(" ")
    if result.returncode == 0 and code.lstrip("-").isdigit() and int(code) in UNRESOLVED:
        return "blocked", f"gaierror {code}: {message}"
    return "error", f"exit {result.returncode}: {answer or result.stderr.strip()[-200:]}"


def reach_all(probes):
    """Runs every probe at once, one thread each, and waits for all of them. Each is bounded by its own
    timeouts (the sockets', the resolver child's); one that raised, could not start, or is still running at
    the deadline is an error."""
    results = {}

    def run(key, function):
        try:
            results[key] = function()
        except Exception as error:
            results[key] = ("error", f"{type(error).__name__}: {error}")

    threads = []
    for key, function in probes.items():
        thread = threading.Thread(target=run, args=(key, function), daemon=True)
        try:
            thread.start()
        except Exception as error:
            results[key] = ("error", f"not started: {type(error).__name__}: {error}")
            continue
        threads.append((key, thread))
    deadline = time.monotonic() + NETWORK_SECONDS
    for _, thread in threads:
        thread.join(max(0, deadline - time.monotonic()))
    answered = dict(results)
    for key, thread in threads:
        if thread.is_alive() or key not in answered:
            answered[key] = ("error", f"still running after {NETWORK_SECONDS} s")
    return answered


def local_addresses():
    """The container's own IPv4 addresses other than loopback, from the kernel's routing table."""
    addresses = set()
    previous = None
    with open("/proc/net/fib_trie") as file:
        for line in file:
            text = line.strip()
            if text.startswith("|--"):
                previous = text.split()[1]
            elif text == "/32 host LOCAL" and previous and not previous.startswith("127."):
                addresses.add(previous)
    return sorted(addresses)


class Listener:
    """A TCP listener on every IPv4 address, on a free port, that answers each request with HTTP 200: the
    positive control. It shows that the HTTP and TCP checks, run in the same concurrent pass, see an open IPv4
    route as open, so their blocked outcomes are not produced by the pass itself. It does not cover TLS or IPv6:
    there a reachable service would answer, or fail with an error that fails the check."""

    def __init__(self):
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.sock.bind(("0.0.0.0", 0))
        self.sock.listen(16)
        self.sock.settimeout(0.5)
        self.port = self.sock.getsockname()[1]
        self.stopped = False
        self.thread = threading.Thread(target=self.serve, daemon=True)
        self.thread.start()

    def serve(self):
        while not self.stopped:
            try:
                connection, _ = self.sock.accept()
            except OSError:
                continue
            with connection:
                connection.settimeout(TIMEOUT)
                try:
                    if connection.recv(4096):
                        connection.sendall(b"HTTP/1.0 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
                except OSError:
                    pass

    def close(self):
        self.stopped = True
        self.thread.join(TIMEOUT)
        self.sock.close()


def network_checks(peers):
    """Every network check in one concurrent pass, so their timeouts overlap, with the listener's controls
    in the same pass. A check holds only when each of its targets is blocked."""
    targets = {
        "internetIPv4Blocked": [("http", "1.1.1.1", 80), ("https", "1.1.1.1", 443)],
        "internetIPv6Blocked": [("http", "2606:4700:4700::1111", 80), ("https", "2606:4700:4700::1111", 443)],
        "metadataServiceBlocked": [("http", "169.254.169.254", 80), ("http", "fd00:ec2::254", 80)],
        "hostUnreachable": [("http", "10.0.0.254", 80), ("https", "10.0.0.254", 443)],
        "otherPortsUnreachable": [("tcp", "1.1.1.1", 22), ("tcp", "10.0.0.254", 22), ("tcp", "1.1.1.1", 53), ("tcp", "10.0.0.254", 8080)],
    }
    if peers:
        # Guesses: each container is a VM of its own that sees itself at 10.0.0.1, so no other container's
        # address can be known from inside one. The listener's controls show a TCP connect would succeed.
        targets["otherContainersUnreachable"] = [("tcp", peer.rsplit(":", 1)[0].strip("[]"), int(peer.rsplit(":", 1)[1])) for peer in peers]
    listener = Listener()
    try:
        # On loopback, and on the container's own addresses where it has any (Docker's `--network none` has none).
        addresses = ["127.0.0.1"] + local_addresses()
        targets["networkChecksDetectListeners"] = [(kind, address, listener.port) for address in addresses for kind in ("http", "tcp")]

        def probe(kind, host, port):
            if kind == "tcp":
                return lambda: tcp_reach(host, port)
            return lambda: http_reach(host, port, kind == "https")

        probes = {(name, f"{kind}://{host}:{port}"): probe(kind, host, port) for name, items in targets.items() for kind, host, port in items}
        probes["publicDnsUnresolvable", "dns"] = dns_reach
        results = reach_all(probes)
    finally:
        listener.close()
    for name in targets:
        found = {key[1]: results[key] for key in probes if key[0] == name}
        expected = ("answered", "connected") if name == "networkChecksDetectListeners" else ("blocked",)
        checks[name] = all(outcome in expected for outcome, _ in found.values())
        details[name] = str({label: f"{outcome}: {detail}" for label, (outcome, detail) in found.items()})[:500]
    outcome, detail = results["publicDnsUnresolvable", "dns"]
    checks["publicDnsUnresolvable"] = outcome == "blocked"
    details["publicDnsUnresolvable"] = f"{outcome}: {detail}"


def fork_limit(limit):
    children = []
    error = None
    try:
        while error is None and len(children) < FORK_ATTEMPTS:
            try:
                children.append(subprocess.Popen(["sleep", "600"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            except OSError as failure:
                error = errno.errorcode.get(failure.errno, str(failure.errno))
    finally:
        for child in children:
            child.kill()
        for child in children:
            child.wait()
    started = len(children)
    ok = error == "EAGAIN" and limit - FORK_BASELINE_MAX <= started < limit
    after = subprocess.run(["true"], timeout=TIMEOUT).returncode == 0
    return ok and after, f"{started} processes, then {error}; a process starts afterwards: {after}"


def main(argv):
    folder_bytes, folder_entries, pids_max = (int(value) for value in argv[1:4])
    cgroup = argv[4]
    peers = argv[5:]
    check("nonRootUser", non_root_user)
    check("commandEnvironmentFixed", fixed_environment)
    check("pid1EnvironmentUnreadable", pid1_environment_unreadable)
    check("inAgentCgroup", lambda: in_agent_cgroup(cgroup))
    check("workspaceWritable", workspace_writable)
    check("workspaceExecutable", lambda: (run_script(WORKSPACE) == "ran", run_script(WORKSPACE)))
    check("tmpNotExecutable", lambda: (run_script("/tmp") == "EACCES", run_script("/tmp")))
    check("homeDirectories", home_directories)
    check("workspaceSizeLimitHolds", lambda: folder_size_limit(folder_bytes))
    check("workspaceEntryLimitHolds", lambda: folder_entry_limit(folder_entries))
    check("rootFilesystemReadOnly", root_read_only)
    check("otherWritableMountsNoexec", writable_elsewhere)
    try:
        network_checks(peers)
    except Exception as error:  # The pass that cannot run fails every network check.
        checks["networkChecks"] = False
        details["networkChecks"] = f"{type(error).__name__}: {error}"
    # Last, since it briefly leaves no room for other processes.
    check("forkLimitHolds", lambda: fork_limit(pids_max))
    sys.stdout.write(json.dumps({"checks": checks, "details": details}) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
