# minerva-fs: the file operations of the agent's tools and the folder's scan, hydration and read-out, run
# in the sandbox as the dropped user (uid 1000, no capabilities, inside the agent cgroup) as
#
#     /usr/bin/python3 -I -S /opt/minerva/minerva-fs <op> <argument>...
#
# through the same wrapper as every agent command (src/sandbox/wrapper.ts). Isolated mode (-I) and no site
# (-S) mean nothing the agent writes can change what runs: no PYTHON* variables, no user site, no current
# directory on the path, and this file sits on the read-only root. Paths are arguments or JSON on stdin,
# never interpolated into a shell. Only the standard library is used.
#
# Answers: one JSON line on stdout, `{"ok": true, "value": ...}` or `{"ok": false, "code": ..., "message":
# ...}` with pi's FileErrorCode, sometimes followed by raw bytes whose length the line gives. The exit status
# is 0 whenever an answer was written; anything else is a failure of the helper itself.
#
# File semantics are today's (worker/src/local-tools.ts WorkspaceEnv over pi's NodeExecutionEnv): files are
# opened with O_NONBLOCK and accepted only when fstat says regular file, so a FIFO never hangs a call; error
# codes follow Node's errno mapping and messages Node's wording, which the model reads. The folder's scan,
# hydration and read-out (`scan`, `hydrate`, `pull`) follow worker/src/folder.ts and the files spec (8.1 to
# 8.3) and walk /workspace one component at a time relative to directory descriptors, each opened with
# O_NOFOLLOW, so a symlinked parent never leads outside the folder.

import errno
import json
import os
import stat
import sys

ENCODING = "utf-8"

# pi's FileErrorCode for an errno (pi's toFileError). Today's WorkspaceEnv, which reads and writes text,
# also maps ENXIO (opening a socket, or a FIFO for writing that nothing reads) to "invalid"; the operations
# it overrides set NXIO_INVALID (local-tools.ts FILE_ERRORS). Everything else is pi's NodeExecutionEnv.
CODES = {
    errno.ENOENT: "not_found",
    errno.EACCES: "permission_denied",
    errno.EPERM: "permission_denied",
    errno.ENOTDIR: "not_directory",
    errno.EISDIR: "is_directory",
    errno.EINVAL: "invalid",
}
NXIO_INVALID = False

# libuv's descriptions, which Node's messages carry ("ENOENT: no such file or directory, open '/x'").
DESCRIPTIONS = {
    errno.ENOENT: "no such file or directory",
    errno.EACCES: "permission denied",
    errno.EPERM: "operation not permitted",
    errno.ENOTDIR: "not a directory",
    errno.EISDIR: "illegal operation on a directory",
    errno.EINVAL: "invalid argument",
    errno.ENXIO: "no such device or address",
    errno.EEXIST: "file already exists",
    errno.ELOOP: "too many symbolic links encountered",
    errno.ENOSPC: "no space left on device",
    errno.EROFS: "read-only file system",
    errno.ENAMETOOLONG: "name too long",
    errno.ENOTEMPTY: "directory not empty",
    errno.EBUSY: "resource busy or locked",
    errno.EMFILE: "too many open files",
    errno.EXDEV: "cross-device link not permitted",
    errno.EFBIG: "file too large",
    errno.EIO: "i/o error",
    errno.EAGAIN: "resource temporarily unavailable",
    errno.EDQUOT: "disk quota exceeded",
    errno.EMLINK: "too many links",
    errno.ETXTBSY: "text file is busy",
}

CHUNK = 1024 * 1024
# A positional read answers at most this much (contracts/sandbox.ts FsAnswers).
MAX_READ = 4 * 1024 * 1024


class Failure(Exception):
    """An expected failure: pi's FileError code and a message."""

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def os_failure(error, syscall, path, dest=None):
    number = error.errno or 0
    name = errno.errorcode.get(number, "UNKNOWN")
    description = DESCRIPTIONS.get(number) or os.strerror(number).lower()
    target = f"'{path}' -> '{dest}'" if dest is not None else f"'{path}'"
    code = "invalid" if number == errno.ENXIO and NXIO_INVALID else CODES.get(number, "unknown")
    return Failure(code, f"{name}: {description}, {syscall} {target}")


def write_line(value):
    out = sys.stdout.buffer
    out.write(json.dumps(value, ensure_ascii=True, separators=(",", ":"), allow_nan=False).encode("ascii") + b"\n")
    out.flush()


def answer(value=None):
    write_line({"ok": True, "value": value})


def refuse(failure):
    write_line({"ok": False, "code": failure.code, "message": failure.message})


def write_all(fd, data):
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise OSError(errno.EIO, "A write took no bytes.")
        view = view[written:]


def name_of(path):
    """Node's basename of a resolved path: "" for "/"."""
    return path.rsplit("/", 1)[-1]


def kind_of(mode):
    if stat.S_ISREG(mode):
        return "file"
    if stat.S_ISDIR(mode):
        return "directory"
    if stat.S_ISLNK(mode):
        return "symlink"
    return None


def info_of(path, st):
    kind = kind_of(st.st_mode)
    if kind is None:
        raise Failure("invalid", "Unsupported file type")
    return {"name": name_of(path), "path": path, "kind": kind, "size": st.st_size, "mtimeMs": st.st_mtime_ns / 1e6}


def decoded(raw):
    """A name as Node reads it from the file system: UTF-8 with invalid bytes replaced."""
    return raw.decode(ENCODING, "replace")


# File operations (pi's FileSystem; contracts/sandbox.ts FsRequest). Paths are absolute: the client resolves
# them against the environment's cwd as pi does.


def op_exists(path):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return answer(False)
    except OSError as error:
        raise os_failure(error, "lstat", path)
    # pi's exists is its fileInfo: a FIFO, socket or device is an "Unsupported file type" error.
    info_of(path, st)
    answer(True)


def op_info(path):
    try:
        st = os.lstat(path)
    except OSError as error:
        raise os_failure(error, "lstat", path)
    answer(info_of(path, st))


def op_canonical(path):
    try:
        resolved = os.path.realpath(path, strict=True)
    except OSError as error:
        raise os_failure(error, "realpath", path)
    answer(resolved)


def open_regular(path, flags, syscall="open", directory_message="Is a directory"):
    """Opens without blocking and keeps the descriptor only for a regular file (WorkspaceEnv)."""
    try:
        fd = os.open(path, flags | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as error:
        raise os_failure(error, syscall, path)
    try:
        st = os.fstat(fd)
    except OSError as error:
        os.close(fd)
        raise os_failure(error, "fstat", path)
    if stat.S_ISDIR(st.st_mode):
        os.close(fd)
        raise Failure("is_directory", directory_message)
    if not stat.S_ISREG(st.st_mode):
        os.close(fd)
        raise Failure("invalid", "Not a regular file")
    return fd, st


def op_read_text(path, max_bytes):
    limit = int(max_bytes)
    fd, st = open_regular(path, os.O_RDONLY)
    try:
        if st.st_size > limit:
            raise Failure("unknown", f"File size ({st.st_size}) is greater than {limit} bytes")
        parts = []
        total = 0
        while True:
            try:
                part = os.read(fd, CHUNK)
            except OSError as error:
                raise os_failure(error, "read", path)
            if not part:
                break
            total += len(part)
            if total > limit:
                raise Failure("unknown", f"File size ({total}) is greater than {limit} bytes")
            parts.append(part)
    finally:
        os.close(fd)
    data = b"".join(parts)
    write_line({"ok": True, "value": {"length": len(data)}})
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def make_parents(path):
    parent = os.path.dirname(path)
    if not parent:
        return
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as error:
        raise os_failure(error, "mkdir", parent)


def op_write(path, mode):
    """`write` (create or truncate) or `append`, with the content on stdin."""
    make_parents(path)
    flags = os.O_WRONLY | os.O_CREAT | (os.O_APPEND if mode == "append" else 0)
    try:
        fd = os.open(path, flags | os.O_NONBLOCK | os.O_CLOEXEC, 0o666)
    except OSError as error:
        raise os_failure(error, "open", path)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Failure("invalid", "Not a regular file")
        if mode != "append":
            os.ftruncate(fd, 0)
        source = sys.stdin.buffer
        while True:
            part = source.read(CHUNK)
            if not part:
                break
            try:
                write_all(fd, part)
            except OSError as error:
                raise os_failure(error, "write", path)
    except OSError as error:
        raise os_failure(error, "write", path)
    finally:
        os.close(fd)
    answer(None)


def op_truncate(path, size):
    length = int(size)
    try:
        fd = os.open(path, os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as error:
        raise os_failure(error, "open", path)
    try:
        os.ftruncate(fd, length)
    except OSError as error:
        raise os_failure(error, "ftruncate", path)
    finally:
        os.close(fd)
    answer(None)


def op_flush(path):
    try:
        fd = os.open(path, os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as error:
        raise os_failure(error, "open", path)
    try:
        if stat.S_ISDIR(os.fstat(fd).st_mode):
            raise Failure("is_directory", "Is a directory")
        os.fsync(fd)
    except OSError as error:
        raise os_failure(error, "fsync", path)
    finally:
        os.close(fd)
    answer(None)


def op_rename(source, destination):
    try:
        os.rename(source, destination)
    except OSError as error:
        raise os_failure(error, "rename", source, destination)
    answer(None)


def op_opendir(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError as error:
        raise os_failure(error, "opendir", path)
    os.close(fd)
    answer(None)


def op_list(path, after, maximum):
    """One page of a directory, by name in byte order after the cursor (the hex of the last name examined)."""
    limit = int(maximum)
    cursor = bytes.fromhex(after) if after else None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError as error:
        raise os_failure(error, "scandir", path)
    try:
        try:
            names = sorted(os.fsencode(name) for name in os.listdir(fd))
        except OSError as error:
            raise os_failure(error, "scandir", path)
        if cursor is not None:
            names = [name for name in names if name > cursor]
        entries = []
        examined = None
        for raw in names:
            if len(entries) >= limit:
                break
            examined = raw
            child = path.rstrip("/") + "/" + decoded(raw) if path != "/" else "/" + decoded(raw)
            try:
                st = os.stat(raw, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                # Removed between the listing and its metadata: not part of the listing any more.
                continue
            except OSError as error:
                raise os_failure(error, "lstat", child)
            if kind_of(st.st_mode) is None:
                continue
            entries.append(info_of(child, st))
        more = examined is not None and names[-1] != examined
    finally:
        os.close(fd)
    answer({"entries": entries, "next": examined.hex() if more else None})


def op_mkdir(path, recursive):
    try:
        if recursive == "1":
            os.makedirs(path, exist_ok=True)
        else:
            os.mkdir(path)
    except OSError as error:
        raise os_failure(error, "mkdir", path)
    answer(None)


def op_remove(path, recursive, force):
    try:
        st = os.lstat(path)
    except FileNotFoundError as error:
        if force == "1":
            return answer(None)
        raise os_failure(error, "lstat", path)
    except OSError as error:
        raise os_failure(error, "lstat", path)
    if stat.S_ISDIR(st.st_mode):
        if recursive != "1":
            # Node's rm: ERR_FS_EISDIR, which pi reports as unknown.
            raise Failure("unknown", f"Path is a directory: rm returned EISDIR (is a directory) {path}")
        import shutil

        failures = []

        def failed(function, target, info):
            failures.append(info[1] if isinstance(info, tuple) else info)

        if sys.version_info >= (3, 12):
            shutil.rmtree(path, onexc=failed)
        else:
            shutil.rmtree(path, onerror=failed)
        if failures:
            error = failures[0]
            if isinstance(error, OSError):
                if force == "1" and error.errno == errno.ENOENT:
                    return answer(None)
                raise os_failure(error, "rm", error.filename or path)
            raise Failure("unknown", str(error))
        return answer(None)
    try:
        os.unlink(path)
    except FileNotFoundError as error:
        if force == "1":
            return answer(None)
        raise os_failure(error, "rm", path)
    except OSError as error:
        raise os_failure(error, "rm", path)
    answer(None)


ALPHANUMERIC = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
TMP = "/tmp"


def random_name(length):
    out = []
    while len(out) < length:
        for byte in os.urandom(length * 2):
            if byte < 248:
                out.append(ALPHANUMERIC[byte % 62])
            if len(out) == length:
                break
    return "".join(out)


def uuid4():
    raw = bytearray(os.urandom(16))
    raw[6] = (raw[6] & 0x0F) | 0x40
    raw[8] = (raw[8] & 0x3F) | 0x80
    text = raw.hex()
    return f"{text[:8]}-{text[8:12]}-{text[12:16]}-{text[16:20]}-{text[20:]}"


def make_temp_dir(prefix):
    # Node's mkdtemp: the prefix and six random characters, mode 0700.
    for _ in range(100):
        path = os.path.join(TMP, prefix + random_name(6))
        try:
            os.mkdir(path, 0o700)
            return path
        except FileExistsError:
            continue
        except OSError as error:
            raise os_failure(error, "mkdtemp", os.path.join(TMP, prefix + "XXXXXX"))
    raise Failure("unknown", "Could not create a temporary directory.")


def op_mktemp(kind, prefix, suffix):
    if kind == "dir":
        return answer(make_temp_dir(prefix))
    directory = make_temp_dir("tmp-")
    path = os.path.join(directory, f"{prefix}{uuid4()}{suffix}")
    try:
        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o666))
    except OSError as error:
        raise os_failure(error, "open", path)
    answer(path)


def op_spill(path):
    """Appends stdin to a file made by `mktemp`, for a command's complete output (pi's spill)."""
    try:
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as error:
        raise os_failure(error, "open", path)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Failure("invalid", "Not a regular file")
        source = sys.stdin.buffer
        while True:
            part = source.read1(CHUNK)
            if not part:
                break
            try:
                write_all(fd, part)
            except OSError as error:
                raise os_failure(error, "write", path)
    finally:
        os.close(fd)
    answer(None)


# The binary reader (pi's BinaryReader): one process per opened file, answering requests on stdin until it
# closes, so reads keep seeing the file that was opened even after a rename (pi's conformance suite).


class LineScanner:
    """pi-durable's LineScanner (env/line-scan.ts): where lines [start, end) of a file are, and the UTF-8
    sizes of the decoded selection and its first line, as decoding the whole file with WHATWG's decoder
    (which drops a leading byte order mark and replaces each maximal invalid subpart) would give them."""

    def __init__(self, start_line, end_line=None):
        if not safe_integer(start_line):
            raise ValueError("Invalid line range")
        if end_line is not None and (not safe_integer(end_line) or end_line <= start_line):
            raise ValueError("Invalid line range")
        self.start_line = start_line
        self.end_line = end_line
        self.position = 0
        self.newlines = 0
        self.line_start = 0
        self.start = None
        self.end = None
        self.first_line_end = None
        self.last_line_start = None
        self.selected_bytes = 0
        self.first_line_bytes = 0
        self.selection = None
        self.first_line = None
        self.head = bytearray()
        self.head_open = True
        self.bom = False
        if start_line == 0:
            self.begin(0)

    @staticmethod
    def decoder():
        import codecs

        return codecs.getincrementaldecoder("utf-8")("replace")

    def is_end_line(self, line):
        return self.end_line is not None and line == self.end_line - 1

    def push(self, chunk):
        if self.head_open:
            take = min(3 - len(self.head), len(chunk))
            self.head += chunk[:take]
            if len(self.head) < 3:
                return
            self.release_head()
            chunk = chunk[take:]
        self.process(chunk)

    def release_head(self):
        head = bytes(self.head)
        self.head_open = False
        self.bom = head[:3] == b"\xef\xbb\xbf"
        self.process(head)

    def process(self, chunk):
        base = self.position
        start = 0
        index = chunk.find(b"\n")
        while index != -1:
            self.feed(chunk, base, start, index)
            line = self.newlines
            position = base + index
            if line == self.start_line:
                self.end_first_line(position)
            if self.is_end_line(line):
                self.end_selection(position)
            self.feed(chunk, base, index, index + 1)
            start = index + 1
            self.newlines += 1
            self.line_start = position + 1
            if self.newlines == self.start_line:
                self.begin(self.line_start)
            if self.is_end_line(self.newlines):
                self.last_line_start = self.line_start
            index = chunk.find(b"\n", start)
        self.feed(chunk, base, start, len(chunk))
        self.position += len(chunk)

    def finish(self):
        if self.head_open:
            self.release_head()
        size = self.position
        if self.start is None:
            return {
                "newlines": self.newlines,
                "start": size,
                "end": size,
                "firstLineEnd": size,
                "lastLineStart": size,
                "selectedBytes": 0,
                "firstLineBytes": 0,
            }
        if self.first_line_end is None:
            self.end_first_line(size)
        if self.end is None:
            self.end_selection(size)
        return {
            "newlines": self.newlines,
            "start": self.start,
            "end": self.end if self.end is not None else size,
            "firstLineEnd": self.first_line_end if self.first_line_end is not None else size,
            "lastLineStart": self.last_line_start if self.last_line_start is not None else self.line_start,
            "selectedBytes": self.selected_bytes,
            "firstLineBytes": self.first_line_bytes,
        }

    def begin(self, start):
        self.start = start
        if self.end_line is not None and self.start_line == self.end_line - 1:
            self.last_line_start = start
        self.selection = self.decoder()
        self.first_line = self.decoder()

    def end_first_line(self, position):
        self.first_line_end = position
        if self.first_line is not None:
            self.first_line_bytes += len(self.first_line.decode(b"", final=True).encode("utf-8"))
        self.first_line = None

    def end_selection(self, position):
        self.end = position
        if self.selection is not None:
            self.selected_bytes += len(self.selection.decode(b"", final=True).encode("utf-8"))
        self.selection = None

    def feed(self, chunk, base, start, end):
        if self.bom and base + start < 3:
            start = min(end, 3 - base)
        if end <= start:
            return
        data = chunk[start:end]
        if self.selection is not None:
            self.selected_bytes += len(self.selection.decode(data).encode("utf-8"))
        if self.first_line is not None:
            self.first_line_bytes += len(self.first_line.decode(data).encode("utf-8"))


def safe_integer(value):
    return isinstance(value, int) and not isinstance(value, bool) and 0 <= value <= 2**53 - 1


def op_reader(path, no_follow):
    flags = os.O_RDONLY | (os.O_NOFOLLOW if no_follow == "1" else 0)
    try:
        fd, st = open_regular(path, flags, directory_message="EISDIR: illegal operation on a directory, read")
    except Failure as failure:
        if no_follow == "1" and failure.message.startswith(("ELOOP:", "EMLINK:")):
            raise Failure("invalid", "Refusing to follow a symbolic link")
        raise
    answer({**info_of(path, st), "dev": st.st_dev, "ino": st.st_ino})
    source = sys.stdin.buffer
    while True:
        line = source.readline(64 * 1024)
        if not line:
            break
        try:
            request = json.loads(line)
            if not isinstance(request, dict):
                raise Failure("invalid", "Invalid request")
            kind = request.get("op")
            if kind == "stat":
                try:
                    answer(info_of(path, os.fstat(fd)))
                except OSError as error:
                    raise os_failure(error, "fstat", path)
            elif kind == "read":
                offset = request.get("offset")
                length = request.get("length")
                if not safe_integer(offset) or not safe_integer(length):
                    raise Failure("invalid", "Offset and length must be non-negative safe integers")
                length = min(length, MAX_READ)
                parts = []
                total = 0
                while total < length:
                    try:
                        part = os.pread(fd, min(CHUNK, length - total), offset + total)
                    except OSError as error:
                        raise os_failure(error, "read", path)
                    if not part:
                        break
                    parts.append(part)
                    total += len(part)
                data = b"".join(parts)
                write_line({"ok": True, "value": {"length": len(data)}})
                sys.stdout.buffer.write(data)
                sys.stdout.buffer.flush()
            elif kind == "scan":
                try:
                    scanner = LineScanner(request.get("start"), request.get("end"))
                except ValueError:
                    raise Failure("invalid", "Invalid line range")
                position = 0
                while True:
                    try:
                        part = os.pread(fd, 64 * 1024, position)
                    except OSError as error:
                        raise os_failure(error, "read", path)
                    if not part:
                        break
                    scanner.push(part)
                    position += len(part)
                answer(scanner.finish())
            else:
                raise Failure("invalid", "Invalid request")
        except Failure as failure:
            refuse(failure)
        except ValueError:
            refuse(Failure("invalid", "Invalid request"))
    os.close(fd)


# The folder (files spec 8): its manifest policy (worker/src/folder.ts, backend/files/manifest.py).

PAGE_BYTES = 4096
MAX_PATH_BYTES = 1024
MAX_SEGMENT_BYTES = 255
MAX_DEPTH = 32
MAX_MTIME = 253_402_300_799_999
WARNINGS_KEPT = 100
WARNING_UNITS = 1024
SCAN_TRIES = 3
RACY_NS = 1_000_000_000
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC


class Changed(Exception):
    """The folder changed while it was scanned."""


class Limit(Exception):
    def __init__(self, limit):
        super().__init__(limit)
        self.limit = limit


class Unreadable(Exception):
    """A file that cannot be opened for reading."""


def is_control(character):
    point = ord(character)
    return point < 0x20 or 0x7F <= point <= 0x9F


def refused_name(name, path_bytes, depth):
    """Why the manifest policy refuses `name` as the last segment of a path `path_bytes` long at `depth`."""
    import unicodedata

    if name in ("", ".", "..") or "/" in name:
        return "invalid_name"
    if not unicodedata.is_normalized("NFC", name) or any(is_control(character) for character in name):
        return "invalid_name"
    if len(name.encode(ENCODING)) > MAX_SEGMENT_BYTES or path_bytes > MAX_PATH_BYTES:
        return "too_long"
    if depth > MAX_DEPTH:
        return "too_deep"
    return None


def refused_path(path):
    if not isinstance(path, str):
        return "invalid_name"
    try:
        path.encode(ENCODING)
    except UnicodeEncodeError:
        return "invalid_name"
    total = 0
    for index, segment in enumerate(path.split("/")):
        total += (1 if index else 0) + len(segment.encode(ENCODING))
        reason = refused_name(segment, total, index + 1)
        if reason:
            return reason
    return None


def pages(size):
    return -(-size // PAGE_BYTES) * PAGE_BYTES


def mtime_of(st):
    ms = st.st_mtime_ns // 1_000_000
    return 0 if ms < 0 else MAX_MTIME if ms > MAX_MTIME else ms


def same_file(a, b):
    """Two stats, or an index entry and a stat: size, mtime, ctime, inode and device all equal."""
    return (a[0], a[1], a[2], a[3], a[4]) == (b[0], b[1], b[2], b[3], b[4])


def key_of(st):
    return (st.st_size, st.st_mtime_ns, st.st_ctime_ns, st.st_ino, st.st_dev)


def index_entry(path, st, sha256, mtime):
    racy = st.st_ctime_ns + RACY_NS >= time_ns()
    return [path, st.st_size, str(st.st_mtime_ns), str(st.st_ctime_ns), str(st.st_ino), str(st.st_dev), sha256, mtime, racy]


def time_ns():
    import time

    return time.time_ns()


def display_path(key):
    """A path as the chat can show it: invalid UTF-8 and controls as U+FFFD, at most 1024 UTF-16 units."""
    text = "".join("�" if is_control(character) else character for character in key.decode(ENCODING, "replace"))
    units = sum(2 if ord(character) > 0xFFFF else 1 for character in text)
    if units <= WARNING_UNITS:
        return text
    kept = []
    used = 0
    for character in text:
        width = 2 if ord(character) > 0xFFFF else 1
        if used + width > WARNING_UNITS - 1:
            break
        kept.append(character)
        used += width
    return "".join(kept) + "…"


def open_root(root):
    try:
        os.makedirs(root, exist_ok=True)
    except FileExistsError:
        pass
    return os.open(root, DIRECTORY_FLAGS)


def walk(root_fd, max_entries):
    """Lists the folder without following links. Every entry met counts against the entry limit."""
    files = []
    dirs = []
    skipped = []
    met = 0

    def visit(dir_fd, key, depth):
        nonlocal met
        names = []
        for name in os.listdir(dir_fd):
            met += 1
            if met > max_entries:
                raise Limit("folder_entries")
            names.append(os.fsencode(name))
        for raw in names:
            child = key + b"/" + raw if key else raw
            try:
                name = raw.decode(ENCODING)
            except UnicodeDecodeError:
                skipped.append((child, "invalid_name"))
                continue
            reason = refused_name(name, len(child), depth + 1)
            if reason:
                skipped.append((child, reason))
                continue
            try:
                st = os.stat(raw, dir_fd=dir_fd, follow_symlinks=False)
            except OSError as error:
                if error.errno in (errno.EACCES, errno.EPERM):
                    skipped.append((child, "unreadable"))
                    continue
                if error.errno == errno.ENAMETOOLONG:
                    skipped.append((child, "too_long"))
                    continue
                if error.errno == errno.ENOENT:
                    raise Changed()
                raise
            path = child.decode(ENCODING)
            if stat.S_ISLNK(st.st_mode):
                skipped.append((child, "symlink"))
            elif stat.S_ISREG(st.st_mode):
                files.append((child, path, st))
            elif not stat.S_ISDIR(st.st_mode):
                skipped.append((child, "special"))
            else:
                try:
                    fd = os.open(raw, DIRECTORY_FLAGS, dir_fd=dir_fd)
                except OSError as error:
                    if error.errno in (errno.ENOENT, errno.ENOTDIR, errno.ELOOP):
                        raise Changed()
                    if error.errno in (errno.EACCES, errno.EPERM):
                        skipped.append((child, "unreadable"))
                        continue
                    raise
                try:
                    opened = os.fstat(fd)
                    if (opened.st_ino, opened.st_dev) != (st.st_ino, st.st_dev):
                        raise Changed()
                    visit(fd, child, depth + 1)
                except OSError as error:
                    if error.errno in (errno.ENOENT, errno.ENOTDIR):
                        raise Changed()
                    if error.errno not in (errno.EACCES, errno.EPERM):
                        raise
                    skipped.append((child, "unreadable"))
                    continue
                finally:
                    os.close(fd)
                dirs.append((child, path))

    visit(root_fd, b"", 0)
    return files, dirs, skipped


class Parents:
    """Directory descriptors along one path, opened one component at a time with O_NOFOLLOW from the root,
    kept while consecutive paths share them."""

    def __init__(self, root_fd, create=False):
        self.root_fd = root_fd
        self.create = create
        self.names = []
        self.fds = []

    def open(self, components):
        common = 0
        while common < len(self.names) and common < len(components) and self.names[common] == components[common]:
            common += 1
        while len(self.names) > common:
            self.names.pop()
            os.close(self.fds.pop())
        for name in components[common:]:
            parent = self.fds[-1] if self.fds else self.root_fd
            if self.create:
                try:
                    os.mkdir(name, 0o777, dir_fd=parent)
                except FileExistsError:
                    pass
            fd = os.open(name, DIRECTORY_FLAGS, dir_fd=parent)
            self.names.append(name)
            self.fds.append(fd)
        return self.fds[-1] if self.fds else self.root_fd

    def close(self):
        while self.fds:
            os.close(self.fds.pop())
        self.names = []


def split_key(key):
    parts = key.split(b"/")
    return parts[:-1], parts[-1]


def hash_file(parent_fd, name, expected):
    import hashlib

    try:
        fd = os.open(name, FILE_FLAGS, dir_fd=parent_fd)
    except OSError as error:
        if error.errno in (errno.EACCES, errno.EPERM):
            raise Unreadable()
        if error.errno in (errno.ENOENT, errno.ELOOP, errno.EMLINK, errno.ENXIO):
            raise Changed()
        raise
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode) or key_of(before) != key_of(expected):
            raise Changed()
        digest = hashlib.sha256()
        total = 0
        while True:
            part = os.read(fd, CHUNK)
            if not part:
                break
            digest.update(part)
            total += len(part)
        after = os.fstat(fd)
        if total != before.st_size or key_of(after) != key_of(before):
            raise Changed()
        return digest.hexdigest(), after
    finally:
        os.close(fd)


def scan_once(root, index, max_bytes, max_entries, rehash_all):
    root_fd = open_root(root)
    try:
        files, dirs, skipped = walk(root_fd, max_entries)
        # Measured before anything is hashed, as tmpfs measures it.
        total = 0
        for _, _, st in files:
            total += pages(st.st_size)
        if total > max_bytes:
            raise Limit("folder_bytes")
        files.sort(key=lambda item: item[0])
        parents = Parents(root_fd)
        kept = []
        entries = []
        try:
            for key, path, st in files:
                cached = index.get(path)
                if cached is not None and not cached[8] and not rehash_all and same_file(
                    (cached[1], int(cached[2]), int(cached[3]), int(cached[4]), int(cached[5])), key_of(st)
                ):
                    sha256, mtime, entry = cached[6], cached[7], cached
                    size = cached[1]
                else:
                    components, name = split_key(key)
                    try:
                        parent_fd = parents.open(components)
                    except OSError as error:
                        if error.errno in (errno.ENOENT, errno.ENOTDIR, errno.ELOOP):
                            raise Changed()
                        if error.errno in (errno.EACCES, errno.EPERM):
                            skipped.append((key, "unreadable"))
                            continue
                        raise
                    try:
                        sha256, hashed = hash_file(parent_fd, name, st)
                    except Unreadable:
                        skipped.append((key, "unreadable"))
                        continue
                    # A file whose mtime did not change keeps the one the manifest gave it, which setting it may
                    # have rounded.
                    mtime = cached[7] if cached is not None and int(cached[2]) == hashed.st_mtime_ns else mtime_of(hashed)
                    entry = index_entry(path, hashed, sha256, mtime)
                    size = hashed.st_size
                mode = 0o755 if st.st_mode & 0o100 else 0o644
                kept.append((key, [path, sha256, mode, mtime, size]))
                entries.append(entry)
        finally:
            parents.close()
    finally:
        os.close(root_fd)
    # A directory is listed when nothing under it was kept.
    parents_of_kept = set()
    for key, _ in kept:
        if b"/" in key:
            parents_of_kept.add(key.rsplit(b"/", 1)[0])
    for key, _ in dirs:
        if b"/" in key:
            parents_of_kept.add(key.rsplit(b"/", 1)[0])
    listed = sorted(key for key, _ in dirs if key not in parents_of_kept)
    skipped.sort(key=lambda item: item[0])
    return {
        "ok": True,
        "files": [entry for _, entry in kept],
        "dirs": [key.decode(ENCODING) for key in listed],
        "warnings": {
            "total": len(skipped),
            "items": [[display_path(key), reason] for key, reason in skipped[:WARNINGS_KEPT]],
        },
        "index": entries,
    }


def write_lines(values):
    """JSON lines to stdout, buffered and flushed once."""
    out = sys.stdout.buffer
    for value in values:
        out.write(json.dumps(value, ensure_ascii=True, separators=(",", ":"), allow_nan=False).encode("ascii") + b"\n")
    out.flush()


def scan_lines(result):
    """A scan's result as lines, so the reader can bound each one and count them: a header with the counts,
    then one line per file with what its index entry holds, one per listed directory, one per warning kept."""
    index = {entry[0]: entry for entry in result["index"]}
    items = result["warnings"]["items"]
    yield {"ok": True, "files": len(result["files"]), "dirs": len(result["dirs"]), "warnings": {"total": result["warnings"]["total"], "items": len(items)}}
    for path, sha256, mode, mtime, size in result["files"]:
        entry = index[path]
        yield [path, sha256, mode, mtime, size, entry[2], entry[3], entry[4], entry[5], entry[8]]
    yield from result["dirs"]
    yield from items


def op_scan():
    """The scan (files spec 8.2): the request on stdin, the manifest, warnings and new index on stdout, as lines
    (scan_lines)."""
    request = json.loads(sys.stdin.buffer.read())
    root = request["root"]
    index = {entry[0]: entry for entry in request.get("index", [])}
    for tries in range(1, SCAN_TRIES + 1):
        try:
            result = scan_once(root, index, int(request["bytes"]), int(request["entries"]), bool(request.get("rehashAll")))
        except Changed:
            if tries >= SCAN_TRIES:
                return write_line({"ok": False, "reason": "changed", "message": "The folder kept changing while it was saved."})
            continue
        except Limit as limit:
            return write_line({"ok": False, "limit": limit.limit})
        return write_lines(scan_lines(result))


class Mismatch(Exception):
    pass


def read_exactly(source, size, digest, sink_fd):
    left = size
    while left > 0:
        part = source.read(min(CHUNK, left))
        if not part:
            raise Mismatch("The stream ended before the file did.")
        digest.update(part)
        write_all(sink_fd, part)
        left -= len(part)


def copy_contents(source_fd, target_fd, size):
    offset = 0
    while offset < size:
        part = os.pread(source_fd, min(CHUNK, size - offset), offset)
        if not part:
            raise Mismatch("A file ended before its size.")
        write_all(target_fd, part)
        offset += len(part)


def op_hydrate():
    """Hydration (files spec 8.1): a JSON line with the root, the listed directories and each distinct blob
    with its size and the files that hold it (`{"root", "dirs", "blobs": [{"sha256", "size", "files": [{"path",
    "mode", "mtime"}]}]}`), then each blob's bytes in that order. A blob is written to its first file, copied to
    the others, and each file then gets its mode and mtime and is indexed, as today's hydration does."""
    import hashlib

    source = sys.stdin.buffer
    plan = json.loads(source.readline())
    root = plan["root"]
    root_fd = open_root(root)
    try:
        if os.listdir(root_fd):
            return write_line({"ok": False, "reason": "not_empty", "message": f"{root} is not empty."})
        paths = list(plan["dirs"])
        for blob in plan["blobs"]:
            paths.extend(file["path"] for file in blob["files"])
        for path in paths:
            if refused_path(path):
                shown = json.dumps(path, ensure_ascii=False)[:200]
                return write_line({"ok": False, "reason": "invalid_path", "message": f"The folder plan holds an invalid path ({shown})."})
        parents = Parents(root_fd, create=True)
        index = []
        try:
            for path in sorted(plan["dirs"]):
                parents.open([os.fsencode(part) for part in path.split("/")])
            for blob in plan["blobs"]:
                size = int(blob["size"])
                targets = []
                try:
                    # Opened first, so a file that cannot be made takes none of the blob's bytes.
                    for file in blob["files"]:
                        components, name = split_key(os.fsencode(file["path"]))
                        parent_fd = parents.open(components)
                        flags = os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC
                        targets.append((file, os.open(name, flags, 0o600, dir_fd=parent_fd)))
                    digest = hashlib.sha256()
                    first_fd = targets[0][1]
                    read_exactly(source, size, digest, first_fd)
                    if digest.hexdigest() != blob["sha256"]:
                        raise Mismatch(f"Blob {blob['sha256']} did not match its hash.")
                    for _, fd in targets[1:]:
                        copy_contents(first_fd, fd, size)
                    for file, fd in targets:
                        mtime = int(file["mtime"])
                        os.fchmod(fd, int(file["mode"]))
                        os.utime(fd, ns=(mtime * 1_000_000, mtime * 1_000_000))
                        index.append(index_entry(file["path"], os.fstat(fd), blob["sha256"], mtime))
                finally:
                    for _, fd in targets:
                        os.close(fd)
        finally:
            parents.close()
        if source.read(1):
            raise Mismatch("The stream holds more bytes than its files.")
        write_lines([{"ok": True, "files": len(index)}, *index])
    except Mismatch as error:
        write_line({"ok": False, "reason": "mismatch", "message": str(error)})
    except OSError as error:
        name = errno.errorcode.get(error.errno or 0, "error")
        write_line({"ok": False, "reason": "failed", "message": f"The folder could not be prepared ({name})."})
    finally:
        os.close(root_fd)


def op_pull(root, path, size):
    """Writes the file at `path` under `root` to stdout, exactly `size` bytes, if it is still a regular file of
    that size; exits 3 otherwise (the folder changed since its scan)."""
    expected = int(size)
    if refused_path(path):
        sys.stderr.write("invalid path\n")
        sys.exit(3)
    root_fd = os.open(root, DIRECTORY_FLAGS)
    parents = Parents(root_fd)
    try:
        components, name = split_key(os.fsencode(path))
        try:
            parent_fd = parents.open(components)
            fd = os.open(name, FILE_FLAGS, dir_fd=parent_fd)
        except OSError as error:
            sys.stderr.write(f"open: {errno.errorcode.get(error.errno or 0, 'error')}\n")
            sys.exit(3)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_size != expected:
                sys.stderr.write("changed\n")
                sys.exit(3)
            out = sys.stdout.buffer
            out.flush()
            sent = 0
            while sent < expected:
                try:
                    count = os.sendfile(1, fd, sent, min(CHUNK, expected - sent))
                except OSError:
                    part = os.pread(fd, min(CHUNK, expected - sent), sent)
                    if part:
                        write_all(1, part)
                    count = len(part)
                if count == 0:
                    sys.stderr.write("shrank\n")
                    sys.exit(3)
                sent += count
        finally:
            os.close(fd)
    finally:
        parents.close()
        os.close(root_fd)


def op_pull_many(root):
    """Writes several files under `root` to stdout, in the order asked (stdin: {"files": [[path, size],
    ...]}): for each, a line `{"ok": true}` and exactly its bytes, or `{"ok": false, "reason": "changed"}`
    and nothing more when it is no longer a regular file of that size. A file that shrinks while it is sent
    ends the stream early and the exit status is 3."""
    request = json.loads(sys.stdin.buffer.readline())
    root_fd = os.open(root, DIRECTORY_FLAGS)
    parents = Parents(root_fd)
    out = sys.stdout.buffer
    try:
        for path, size in request["files"]:
            expected = int(size)
            fd = None
            if not refused_path(path):
                components, name = split_key(os.fsencode(path))
                try:
                    parent_fd = parents.open(components)
                    fd = os.open(name, FILE_FLAGS, dir_fd=parent_fd)
                except OSError:
                    fd = None
            try:
                if fd is None:
                    write_line({"ok": False, "reason": "changed"})
                    return
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode) or st.st_size != expected:
                    write_line({"ok": False, "reason": "changed"})
                    return
                write_line({"ok": True})
                out.flush()
                sent = 0
                while sent < expected:
                    part = os.pread(fd, min(CHUNK, expected - sent), sent)
                    if not part:
                        sys.exit(3)
                    write_all(1, part)
                    sent += len(part)
            finally:
                if fd is not None:
                    os.close(fd)
    finally:
        parents.close()
        os.close(root_fd)


# Watching (pi's FileSystem.watch, which the Sandbox's environment answers by polling): a signature of every
# watched path, compared between polls by the caller.


def signature(st):
    if stat.S_ISREG(st.st_mode):
        return f"f:{st.st_size}:{st.st_mtime_ns}:{st.st_ctime_ns}:{st.st_ino}"
    if stat.S_ISDIR(st.st_mode):
        return f"d:{st.st_ino}"
    return f"o:{stat.S_IFMT(st.st_mode)}:{st.st_mtime_ns}:{st.st_ctime_ns}:{st.st_ino}"


def followed(path, st):
    """A symbolic link's signature includes what it names and that file's own, so a change to the target shows."""
    if not stat.S_ISLNK(st.st_mode):
        return signature(st)
    try:
        target = os.readlink(path)
    except OSError:
        target = ""
    try:
        return f"l:{target}:{signature(os.stat(path))}"
    except OSError:
        return f"l:{target}:missing"


class Overflow(Exception):
    pass


def op_snapshot():
    """Signatures of the watched paths (stdin: {"targets": [...], "maxEntries": n}): each target itself, a
    directory target's entries, and a recursive one's whole tree without following links below it, excluded
    names left out."""
    request = json.loads(sys.stdin.buffer.read())
    limit = int(request["maxEntries"])
    entries = {}

    def add(path, value):
        if path not in entries and len(entries) >= limit:
            raise Overflow()
        entries[path] = value

    def excluded(name, exclude):
        return (exclude.get("hidden") and name.startswith(".")) or name in (exclude.get("names") or [])

    def walk(directory, recursive, exclude):
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            return
        for name in names:
            if excluded(name, exclude):
                continue
            child = directory.rstrip("/") + "/" + name if directory != "/" else "/" + name
            try:
                st = os.lstat(child)
            except OSError:
                continue
            add(child, signature(st))
            if recursive and stat.S_ISDIR(st.st_mode):
                walk(child, True, exclude)

    try:
        for target in request["targets"]:
            path = target["path"]
            try:
                st = os.lstat(path)
            except OSError:
                continue
            add(path, followed(path, st))
            try:
                directory = stat.S_ISDIR(os.stat(path).st_mode)
            except OSError:
                directory = False
            if directory:
                walk(path, bool(target.get("recursive")), target.get("exclude") or {})
    except Overflow:
        return answer({"overflow": True})
    answer({"entries": entries})


# The file operations a Sandbox serves from one long-lived process, so a call costs no interpreter start.
SERVED = ("snapshot", "exists", "info", "canonical", "read-text", "write", "truncate", "flush", "rename", "opendir", "list", "mkdir", "remove", "mktemp")


class Buffered:
    """A stand-in for sys.stdin or sys.stdout whose `buffer` is in memory."""

    def __init__(self, buffer):
        self.buffer = buffer


def op_serve():
    """Answers file operations until stdin closes. A request is a JSON line `{"op", "args", "stdin"}` followed by
    `stdin` bytes; the answer is a line `{"length": n}` followed by the n bytes the operation wrote, which are
    what running it alone would have written to stdout."""
    import io

    global NXIO_INVALID
    source = sys.stdin.buffer
    sink = sys.stdout.buffer
    real_in, real_out = sys.stdin, sys.stdout
    while True:
        line = source.readline(1024 * 1024)
        if not line:
            return
        try:
            request = json.loads(line)
            op, arguments, length = request["op"], [str(argument) for argument in request["args"]], int(request.get("stdin", 0))
        except (ValueError, KeyError, TypeError):
            sys.exit(2)
        data = source.read(length) if length else b""
        if len(data) != length:
            sys.exit(2)
        out = io.BytesIO()
        sys.stdin, sys.stdout = Buffered(io.BytesIO(data)), Buffered(out)
        try:
            entry = OPS.get(op)
            if op not in SERVED or entry is None or len(arguments) != entry[1]:
                refuse(Failure("unknown", f"{op} is not served"))
            else:
                NXIO_INVALID = op == "read-text" or (op == "write" and arguments[1:2] == ["write"])
                try:
                    entry[0](*arguments)
                except Failure as failure:
                    refuse(failure)
                except Exception as error:  # An operation that breaks answers instead of ending the server.
                    refuse(Failure("unknown", f"{type(error).__name__}: {error}"))
        finally:
            sys.stdin, sys.stdout = real_in, real_out
        answer_bytes = out.getvalue()
        sink.write(json.dumps({"length": len(answer_bytes)}).encode("ascii") + b"\n")
        sink.write(answer_bytes)
        sink.flush()


OPS = {
    "serve": (op_serve, 0),
    "snapshot": (op_snapshot, 0),
    "exists": (op_exists, 1),
    "info": (op_info, 1),
    "canonical": (op_canonical, 1),
    "read-text": (op_read_text, 2),
    "write": (op_write, 2),
    "truncate": (op_truncate, 2),
    "flush": (op_flush, 1),
    "rename": (op_rename, 2),
    "opendir": (op_opendir, 1),
    "list": (op_list, 3),
    "mkdir": (op_mkdir, 2),
    "remove": (op_remove, 3),
    "mktemp": (op_mktemp, 3),
    "spill": (op_spill, 1),
    "reader": (op_reader, 2),
    "scan": (op_scan, 0),
    "hydrate": (op_hydrate, 0),
    "pull": (op_pull, 3),
    "pull-many": (op_pull_many, 1),
}


def main(argv):
    if len(argv) < 2 or argv[1] not in OPS:
        sys.stderr.write("usage: minerva-fs <op> <argument>...\n")
        return 2
    function, count = OPS[argv[1]]
    arguments = argv[2:]
    if len(arguments) != count:
        sys.stderr.write(f"minerva-fs {argv[1]} takes {count} arguments\n")
        return 2
    global NXIO_INVALID
    NXIO_INVALID = argv[1] == "read-text" or (argv[1] == "write" and arguments[1:2] == ["write"])
    try:
        function(*arguments)
    except Failure as failure:
        refuse(failure)
    return 0


