# Minerva backend: one image for the web, gateway, supervisor and migrate roles.
# Build context: backend/ (see .github/workflows/main.yml).
FROM ghcr.io/astral-sh/uv:0.12.23 AS uv

FROM python:3.14-slim-trixie AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/backend/.venv
WORKDIR /app/backend
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
COPY . .

FROM python:3.14-slim-trixie
# config.py treats parents[2] of backend/minerva/config.py as the repository root, so the code lives
# at /app/backend. There is no .env in the image: configuration comes from the container environment.
ENV PATH=/app/backend/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=minerva.settings
# /var/lib/minerva/files holds agent files (MINERVA_FILES_DIR). A new volume mounted there copies its owner.
RUN groupadd --system --gid 10001 minerva \
    && useradd --system --uid 10001 --gid minerva --home-dir /app --no-create-home minerva \
    && install -d -o 10001 -g 10001 /var/lib/minerva/files
WORKDIR /app/backend
COPY --from=build --chown=root:root /app/backend /app/backend
USER 10001:10001
EXPOSE 8000 8001
CMD ["uvicorn", "minerva.asgi:application", "--host", "0.0.0.0", "--port", "8000", "--lifespan", "off"]
